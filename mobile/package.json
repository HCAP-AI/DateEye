{
  "name": "prod-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "export": "expo export --platform ios --output-dir dist-ios && expo export --platform android --output-dir dist-android"
  },
  "dependencies": {
    "expo": "~55.0.31",
    "expo-secure-store": "~55.0.18",
    "expo-status-bar": "~55.0.6",
    "expo-web-browser": "~55.0.20",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-dom": "19.2.0",
    "react-native-web": "~0.21.0",
    "expo-dev-client": "~55.0.40"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
  },
  "type": "module"
}
